# === Claude Code — state per-máy, KHÔNG share ===
# Permission allowlist + hook wiring riêng từng máy. settings.json (shared) vẫn track.
.claude/settings.local.json
.claude/node_modules/

# GSD framework — cài per-máy qua installer (npx get-shit-done-cc --claude --local),
# không phải source của project này.
.claude/.gsd-profile
.claude/gsd-install-state.json
.claude/gsd-file-manifest.json
.claude/gsd-migration-journal/
.claude/get-shit-done/
.claude/package.json
.claude/agents/
.claude/commands/gsd/
# Installer bản hiện tại giải nén runtime vào .claude/gsd-core/ — harness, không phải source.
# LƯU Ý: KHÔNG ignore .claude/commands/gsd-*.md — nghi ngờ file bị gitignore thì
# slash command không được quét, làm /gsd-* báo "Unknown command" (2026-07-29).
.claude/gsd-core/
.claude/scripts/
# hooks/ toàn bộ là GSD-managed, chỉ wire từ settings.local.json.
.claude/hooks/

