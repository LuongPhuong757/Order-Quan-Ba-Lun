# Cấu hình cổng MISA CukCuk Open Platform — lấy tại: web CukCuk → Ứng dụng → API.
# Copy file này thành scripts/cukcuk.env (đã được .gitignore) rồi điền giá trị thật.
#
# Chạy:  set -a; . scripts/cukcuk.env; set +a; node scripts/cukcuk-spike.mjs login

# "Tên kết nối" trên trang cấu hình — KHÔNG phải tên miền web.
CUKCUK_DOMAIN=quanonglun
CUKCUK_APP_ID=CUKCUKOpenPlatform
# "Mã bảo mật" — 64 ký tự hex. Ô input trên web hiển thị CỤT, phải Ctrl+A rồi copy.
CUKCUK_SECRET_KEY=

# Lấy từ: node scripts/cukcuk-spike.mjs branches
CUKCUK_BRANCH_ID=0c80bd83-3742-4bb4-847a-e7dd095eedb0
# Lấy từ: node scripts/cukcuk-spike.mjs items
CUKCUK_TEST_ITEM=
