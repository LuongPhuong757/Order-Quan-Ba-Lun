# ─────────────────────────────────────────────────────────────────────────────
# Mẫu env cho STACK DEVELOP (docker-compose.dev.yml).
# File thật sống ở /opt/ordbl-dev/.env.dev TRÊN VPS và KHÔNG nằm trong git.
#
# `./deploy-dev.sh --init` tự sinh file thật với secrets random — bản này chỉ để
# tra cứu xem có những biến gì và sửa tay khi cần.
#
# (Tên file không bắt đầu bằng `.env` là có lý do: `.gitignore` nuốt mọi `.env.*`.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ───────────────────────────────────────────────────────────────────
# Domain gốc, KHÔNG có tiền tố dev. Site dev sẽ là:
#   dev.<DOMAIN>        → trang khách (shop-dist)
#   admin.dev.<DOMAIN>  → trang quản lý (web-dist — main.ts chọn theo tiền tố `admin.`)
# Cả hai bản ghi A phải trỏ về IP VPS TRƯỚC khi deploy, không thì Caddy không xin
# được cert (Let's Encrypt giới hạn 5 lần thất bại trùng lặp / tuần / domain).
DOMAIN=quanbalun.site

# ── Basic auth — thứ duy nhất chặn người lạ vào server dev ────────────────────
# Hash bcrypt, sinh bằng:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'matkhau'
# deploy-dev.sh đọc 2 biến này để render caddy-local/dev.caddy.
# ĐỂ TRỐNG HASH = deploy-dev.sh từ chối chạy. Không có cửa "tạm thời mở".
DEV_AUTH_USER=dev
DEV_AUTH_HASH=

# ── MySQL (DB RIÊNG, volume riêng — không dính gì tới DB prod) ────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=order_quan_balun_dev
MYSQL_USER=ordbl_dev
MYSQL_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────────
# JWT_SECRET KHÁC prod là bắt buộc: dùng chung secret nghĩa là token ký ở dev
# đăng nhập thẳng được vào prod.
JWT_SECRET=
JWT_LIFETIME_DAYS=7
COOKIE_NAME=ssp_token_dev
COOKIE_SECURE=true

# CSRF allow-list — phải khớp đúng protocol+host của từng site dev.
ALLOWED_ORIGIN=https://dev.quanbalun.site,https://admin.dev.quanbalun.site

# IP được phép mở /setup (tạo owner đầu tiên). Danh sách khớp CHÍNH XÁC, không CIDR.
# Nhà đổi IP thì chạy `./deploy-dev.sh --allow-setup` để cập nhật tự động.
SETUP_ALLOWED_IP=127.0.0.1

# Salt hash IP luồng public. Bỏ trống = rơi về salt dev mặc định trong code.
IP_HASH_SALT=

# ── SMS / OTP ────────────────────────────────────────────────────────────────
# console + log = KHÔNG bắn tin thật, OTP chỉ hiện trong `docker logs ordbl_dev_api`.
# Đổi sang esms là tốn tiền thật và nhắn vào số điện thoại thật của người ta.
SMS_DRIVER=console
OTP_CHANNEL=log
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=2
ESMS_SANDBOX=
OTP_SMS_TEMPLATE=
