# === Database ===
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=order_quan_balun
MYSQL_USER=order_app
MYSQL_PASSWORD=order_app_pass
MYSQL_HOST=localhost
MYSQL_PORT=3306

# === API (NestJS) ===
API_PORT=3001
NODE_ENV=development

# === Auth (F-17 JWT 7d cookie) ===
JWT_SECRET=replace-with-strong-random-256-bit-secret-CHANGE-ME
JWT_LIFETIME_DAYS=7
COOKIE_NAME=ssp_token
COOKIE_SECURE=false  # set true in production (HTTPS only)
BCRYPT_COST=10

# === Setup wizard guard (P01.D-24) ===
# Allow setup wizard only from this IP — comma-separated for multiple
SETUP_ALLOWED_IP=127.0.0.1,::1

# === CSRF Origin check (P01.D-12, M2.D-67) ===
# Danh sách phân tách dấu phẩy. 5173 = web (trang quản lý), 5174 = shop (trang khách).
# So khớp CHÍNH XÁC protocol+host, không phải prefix (C-SEC-01) — nên phải ghi đủ cả port.
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174

# === Hash IP cho đơn online (M2.D-56) ===
# Salt thật sinh bằng `openssl rand -hex 32`. Đổi salt = mất khả năng đối chiếu hash cũ.
IP_HASH_SALT=dev-ip-salt-CHANGE-ME

# === FE (Vite) ===
VITE_API_BASE_URL=http://localhost:3001

# === SMS driver (M2.D-63, D-15) — chọn console (mặc định, chỉ ghi log) hoặc esms (gọi API thật) ===
# Đổi driver bằng cách đổi giá trị dưới đây — không cần sửa dòng code nào.
SMS_DRIVER=console
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
# Để trống ở local. Nếu bật esms mà thiếu key, SMS trả lỗi có log, không làm sập poller.
