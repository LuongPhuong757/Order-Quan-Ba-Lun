# Caddy reverse proxy → API container.
# HTTPS auto qua Let's Encrypt — Caddy tự cấp + renew cert.
# DOMAIN env (vd: quanbalun.site) — set ở .env.production.
#
# Hai site block, CÙNG trỏ về một container ordbl_api:3001. main.ts chọn thư mục static theo
# Host header (M2.D-66): host bắt đầu `admin.` → web-dist, còn lại → shop-dist.
#
# 2026-09-07 — upstream phải là TÊN CONTAINER `ordbl_api`, KHÔNG BAO GIỜ là tên service `api`.
# Stack develop (`docker-compose.dev.yml`, project `ordbl-dev`) cũng có service tên `api`, và
# container Caddy này được đấu vào cả network của prod lẫn của dev (caddy-extra-networks.txt).
# Docker DNS khi đó phân giải `api` sang container nào tuỳ network nào tới trước — sáng
# 2026-09-07 nó chọn `ordbl_dev_api`, nên toàn bộ trang production (apex + admin + menu) chạy
# trên backend và DATABASE DEV suốt ~1 tiếng. Không có lỗi nào: mọi request vẫn 200, chỉ là
# đọc ghi sai database. Tên container là duy nhất toàn máy nên không có chỗ cho nhập nhằng.
# Chốt chặn phát hiện lại: xem `./deploy.sh --verify` và field `env` của /api/public/health.
#
# 2026-08-05 — apex thuộc về TRANG KHÁCH (trước đây là trang quản lý). Địa chỉ ngắn nhất
# dành cho người gõ tay và quét QR; nhân viên bookmark admin.<domain> một lần là xong.

# ─── Trang khách: apex + www ────────────────────────────────────────────────
{$DOMAIN}, www.{$DOMAIN} {
    log {
        output stdout
        format console
    }

    reverse_proxy ordbl_api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        # C-INFRA-03 — order_token là bearer credential nằm ngay trong URL /o/<token>.
        # no-referrer để token không rò sang site ngoài qua header Referer.
        # KHÁC block admin (strict-origin-when-cross-origin) là có chủ ý.
        Referrer-Policy "no-referrer"
        # M2.D-69 — geolocation BẬT cho khách (nút "Chia sẻ vị trí" khi chọn giao hàng).
        # Block admin bên dưới giữ geolocation=() vì màn quản lý không cần.
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    }

    # Compression — giảm 60-80% payload JSON
    encode zstd gzip
}

# ─── Trang quản lý: admin.<domain> ──────────────────────────────────────────
admin.{$DOMAIN} {
    log {
        output stdout
        format console
    }

    reverse_proxy ordbl_api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # camera=(self): màn quản lý quét mã bằng camera. geolocation tắt hẳn.
        Permissions-Policy "geolocation=(), camera=(self), microphone=()"
        # Màn quản lý không bao giờ nên nằm trong kết quả tìm kiếm.
        X-Robots-Tag "noindex, nofollow"
    }

    # Compression — giảm 60-80% payload JSON
    encode zstd gzip
}

# ─── Quyển menu điện tử: menu.<domain> ──────────────────────────────────────
# 2026-09-04 — trang CHỈ ĐỌC cho khách xem toàn bộ món (nhà đang thiếu menu giấy).
# Cùng vào ordbl_api:3001 và cùng nhận shop-dist như apex: `main.ts` chỉ tách riêng host
# `admin.`, mọi host còn lại đều là app khách. Việc chọn vẽ quyển menu thay vì màn đặt
# hàng do `apps/shop/src/main.tsx` quyết định trong trình duyệt, theo `location.hostname`.
menu.{$DOMAIN} {
    log {
        output stdout
        format console
    }

    reverse_proxy ordbl_api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        # KHÁC block apex (no-referrer): ở đó `Referer` có thể rò `order_token` nằm trong
        # URL /o/<token>. Trang menu không có token nào trong đường dẫn, nên giữ mức
        # thường để còn biết khách tới từ Facebook hay Zalo.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Quyển menu không cần bất cứ quyền thiết bị nào — kể cả vị trí (khác apex, nơi
        # khách bấm "Chia sẻ vị trí" lúc chọn giao hàng).
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
    }

    # CỐ Ý KHÔNG có `X-Robots-Tag: noindex` (khác block admin): quán MUỐN trang này nằm
    # trong kết quả tìm kiếm — người ta google "menu quán bà lùn" là ra ngay.

    encode zstd gzip
}

# ─── Site khác dùng chung Caddy này ─────────────────────────────────────────
# Container Caddy này KHÔNG chỉ phục vụ Quán Bà Lùn — trên VPS còn ứng dụng khác
# (ui2spec.pro.vn / genspec) trỏ qua đây. Trước đây các block đó được thêm TAY thẳng
# vào file này trên server, khiến `git pull` lúc deploy bị chặn vì local change; ghi đè
# đại là site kia sập mà không ai biết cho tới khi có người phàn nàn.
#
# Nên: file này thuộc về repo và deploy được ghi đè thoải mái; cấu hình của site khác nằm
# ở ./caddy-local/*.caddy trên server (KHÔNG tracked, không bị deploy đụng vào).
# Glob không khớp file nào cũng hợp lệ — repo mới clone chưa có gì trong đó vẫn chạy.
import /etc/caddy/local/*.caddy
