# Production environment variables.
# Copy thành .env.production rồi sửa secrets. KHÔNG commit .env.production lên git.
#
# Generate secrets: openssl rand -base64 48

# ─── Domain ────────────────────────────────────────────────
# Domain trỏ về IP VPS (qua A record DNS). Caddy auto cấp Let's Encrypt cert.
# Cần 3 A record cùng trỏ về IP VPS: @ , www , admin
#   quanbalun.site + www  → trang khách
#   admin.quanbalun.site  → trang quản lý
DOMAIN=quanbalun.site

# ─── MySQL ─────────────────────────────────────────────────
# Random 32+ ký tự cho root password
MYSQL_ROOT_PASSWORD=CHANGE_ME_random_64_chars
MYSQL_DATABASE=order_quan_balun
# User app — KHÔNG dùng default 'order_app' cho prod
MYSQL_USER=ordbl_app
MYSQL_PASSWORD=CHANGE_ME_random_32_chars

# ─── JWT ───────────────────────────────────────────────────
# CRITICAL: random 64+ ký tự, KHÔNG share. Đổi = mọi session hiện tại invalidate.
JWT_SECRET=CHANGE_ME_random_64_chars_openssl_rand_base64_48
JWT_LIFETIME_DAYS=7
COOKIE_NAME=ssp_token

# ─── CSRF Origin check (P01.D-12, M2.D-67) ─────────────────
# BẮT BUỘC phải có: docker-compose.prod.yml đã truyền ALLOWED_ORIGIN vào container api.
# Để trống = middleware rơi về default localhost → MỌI mutation của admin bị 403.
#
# Danh sách phân tách dấu phẩy: apex + www (trang khách) + admin. (trang quản lý).
# So khớp CHÍNH XÁC protocol+host, không phải prefix (C-SEC-01) — ghi đủ https:// và đúng
# tên miền, không có dấu / cuối. Phải khớp DOMAIN ở trên.
# Thiếu hostname nào thì MỌI mutation từ hostname đó bị CSRF guard trả 403.
ALLOWED_ORIGIN=https://quanbalun.site,https://www.quanbalun.site,https://admin.quanbalun.site

# ─── Setup endpoint allowlist ──────────────────────────────
# IP của chủ quán (truy cập /setup tạo owner đầu tiên).
# Sau khi setup xong, có thể đổi về 127.0.0.1 để khoá.
# Nhiều IP cách dấu phẩy: 1.2.3.4,5.6.7.8
SETUP_ALLOWED_IP=YOUR_HOME_IP

# ─── Backup MySQL (sidecar mysql-backup) ────────────────────
# Giờ chạy tính theo UTC. VN = UTC+7 → 20:30 UTC = 03:30 sáng giờ VN (quán đã đóng).
BACKUP_HOUR_UTC=20
BACKUP_MINUTE=30
# Giữ backup bao nhiêu ngày, và số bản tối thiểu luôn giữ lại bất kể tuổi.
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=7

# ─── Hash IP cho đơn online (M2.D-56) ───────────────────────
# Sinh bằng `openssl rand -hex 32`. Đổi salt = mất khả năng đối chiếu hash cũ.
IP_HASH_SALT=replace-with-openssl-rand-hex-32
