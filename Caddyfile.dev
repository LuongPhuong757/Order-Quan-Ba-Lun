# TEMPLATE site block cho STACK DEVELOP. KHÔNG phải file Caddy chạy trực tiếp —
# deploy-dev.sh thay placeholder rồi ghi ra `caddy-local/dev.caddy` trong thư mục
# checkout PROD trên VPS; Caddyfile của prod đã có sẵn `import /etc/caddy/local/*.caddy`.
#
# Vì sao render ra file thay vì thêm block thẳng vào Caddyfile của prod:
# domain là cấu hình riêng của server, và quan trọng hơn — một block dev sai cú pháp
# nằm trong Caddyfile của prod là Caddy không load được config, tức là SẬP CẢ TRANG
# QUÁN. Ở đây gỡ dev chỉ cần xoá đúng một file.
#
# Placeholder: __DOMAIN__

# ─── Server develop: dev.<domain> (khách) + admin.dev.<domain> (quản lý) ─────
# Cùng vào ordbl_dev_api:3001. main.ts chọn bundle theo tiền tố `admin.` của Host,
# nên `admin.dev.<domain>` nhận web-dist còn `dev.<domain>` nhận shop-dist — y hệt
# cách prod phân biệt, không cần cấu hình gì thêm.
#
# KHÔNG có basic auth (gỡ 2026-09-09 theo yêu cầu): site dev mở cho mọi người,
# đúng như prod. Thứ duy nhất còn giới hạn là `/setup` — chặn theo SETUP_ALLOWED_IP
# trong .env.dev — và `X-Robots-Tag` giữ bản test khỏi Google.
dev.__DOMAIN__, admin.dev.__DOMAIN__ {
    log {
        output stdout
        format console
    }

    reverse_proxy ordbl_dev_api:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        # Bật geolocation + camera: server dev phải thử được CẢ hai luồng
        # (khách chia sẻ vị trí ở trang đặt hàng, nhân viên quét mã ở trang quản lý).
        Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
        # Không đời nào để bản test lọt vào Google bên cạnh trang thật của quán.
        X-Robots-Tag "noindex, nofollow"
    }

    encode zstd gzip
}
